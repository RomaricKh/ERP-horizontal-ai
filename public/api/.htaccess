RewriteEngine On

# If file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise route to API front controller
RewriteRule ^ index.php [L]

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>